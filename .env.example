PG_PASSWORD=
JWT_KEY=
CONFIG_ENCRYPTION_KEY=
DEEPSEEK_API_KEY=

# 联网搜索（spec §91，可不配；不配时管家没有联网搜索）：https://tavily.com 申请
TAVILY_API_KEY=

# 发信（注册、验证码登录、找回密码要发验证码，§155、§174）。端口 465 用 SSL，587 用 STARTTLS。
# QQ 邮箱：smtp.qq.com / 465，密码填"授权码"（QQ 邮箱 → 设置 → 账号 → 开启 SMTP 服务后生成），不是登录密码
# 163 邮箱：smtp.163.com / 465，同样填授权码；腾讯企业邮：smtp.exmail.qq.com / 465
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=IronM

# ---- 用 Docker 跑时（spec §185，docker compose up -d）----
# 上面的 PG_PASSWORD、JWT_KEY、CONFIG_ENCRYPTION_KEY 是给 scripts/start.sh 用的，Docker 不读，它自己生成、存在数据卷里。
# 发信（EMAIL_*）、联网搜索（TAVILY_API_KEY）两种跑法都读；别的项 Docker 不读。下面几项只有 Docker 用，都可以不写：
# IRONM_PORT=18090                 网页端口（被占了就换一个，比如 18200）
# IRONM_IMAGES=1                   启动时在后台补下配图（只下还没有的）；写 0 不下
# DOCKER_MIRROR=docker.1ms.run/    国内下镜像慢或下不了时的加速前缀，末尾的 / 要带
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/   国内 Python 包源
# APT_MIRROR=mirrors.aliyun.com    国内系统包源
